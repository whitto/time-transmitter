+static bool readBluetoothWatchBattery(void) {
+  String name = btLastWatchName.length() ? btLastWatchName :
+                btPairModeActive ? String("") : btProfileName[btActiveProfile];
+  name.toUpperCase();
+  if (btActiveProtocol != BT_PROTOCOL_BX5600_MIP || name.indexOf("GW-BX5600") < 0 ||
+      btLastWatchAddress.length() != 17) {
+    btPendingBatteryStatus = "Unavailable: battery reading supports identified GW-BX5600 watches";
+    return false;
+  }
+  const auto ready = []() {
+    return !bleOperationCancelled() &&
+           btClientPreemptionEnabled.load(std::memory_order_acquire) &&
+           btClientConnected.load(std::memory_order_acquire);
+  };
+  const auto failed = [](const char *reason) {
+    btPendingBatteryStatus = reason;
+    Serial.printf("BT: battery read unavailable: %s\n", reason);
+    return false;
+  };
+  btGattStage = "BX battery discovery";
+  if (!ready() || !btService || !btSetChar)
+    return failed("Watch disconnected or RF cancelled the battery read");
+  auto request = btService->getCharacteristic(NimBLEUUID(CASIO_BASIC_REQUEST_CHAR));
+  if (!ready()) return failed("Watch disconnected or RF cancelled the battery read");
+  if (!request || !request->canWriteNoResponse())
+    return failed("Watch-condition request characteristic unavailable");
+  btGattStage = "BX battery subscription";
+  bool subscribed = false;
+  if (btSetChar->canNotify()) subscribed = btSetChar->subscribe(true, gshockNotifyCallback, true);
+  else if (btSetChar->canIndicate()) subscribed = btSetChar->subscribe(false, gshockNotifyCallback, true);
+  if (!ready()) return failed("Watch disconnected or RF cancelled the battery read");
+  if (!subscribed) return failed("Watch-condition notification subscription rejected");
+  const uint8_t command[] = {CasioWatchBattery::kHeader};
+  btGattStage = "BX battery request";
+  prepareBtResponse(command[0]);
+  // Captures use GET with a Write Command, never an ATT Write Request.
+  if (!writeBt(request, command, sizeof(command), false)) {
+    cancelBtResponse();
+    return failed("Watch-condition request could not be sent");
+  }
+  if (!waitBt(CasioWatchBattery::kBxResponseSize, CasioWatchBattery::kReplyTimeoutMs))
+    return failed("No complete battery reply (timeout, disconnect or RF cancellation)");
+  portENTER_CRITICAL(&btResponseMux);
+  const size_t received = btResponseLength;
+  const bool overflow = btResponseOverflow;
+  portEXIT_CRITICAL(&btResponseMux);
+  uint8_t reply[CasioWatchBattery::kBxResponseSize], percent = 0;
+  if (overflow || received != sizeof(reply) || !ready() ||
+      copyBt(reply, sizeof(reply)) != received ||
+      !CasioWatchBattery::decodeBx(reply, received, percent))
+    return failed("Invalid or incomplete watch-condition reply");
+  btPendingBattery.available = true;
+  btPendingBattery.percent = percent;
+  btPendingBattery.sampledUtc = time(nullptr);
+  strlcpy(btPendingBattery.address, btLastWatchAddress.c_str(), sizeof(btPendingBattery.address));
+  btPendingBatteryStatus = "Read during sync";
+  Serial.printf("BT: Watch %u battery estimate %u%% (raw=%u)\n",
+                (unsigned)btActiveProfile + 1, percent, reply[1]);
+  return true;
+}
+
+static void commitBluetoothBattery(void) {
+  auto &reading = btBatteryReadings[btActiveProfile];
+  // A replacement becomes bound only after TIME succeeds. Do not attach an
+  // old watch's reading to a newly paired device when its battery read failed.
+  if (btActiveProtocol != BT_PROTOCOL_BX5600_MIP ||
+      !reading.matches(btProfileAddress[btActiveProfile].c_str())) reading = {};
+  if (btPendingBattery.matches(btProfileAddress[btActiveProfile].c_str()) &&
+      btActiveProtocol == BT_PROTOCOL_BX5600_MIP) reading = btPendingBattery;
+  btBatteryStatuses[btActiveProfile] = btPendingBatteryStatus;
 }
 
